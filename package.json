{
  "name": "@crgolden/modules",
  "version": "0.3.2",
  "description": "Shared TypeScript modules for the crgolden fleet, published as one package with one subpath export per module.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crgolden/Modules.git"
  },
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": ["dist/*/index.d.ts"]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node dist-test/eslint-angular/rules.test.js && node dist-test/synthetic-walker/login.test.js",
    "enroll-passkey": "npm run build && node dist/synthetic-walker/enroll-passkey.js",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.61.0 <2",
    "eslint": ">=10 <11"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular-eslint/template-parser": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.0"
  }
}
